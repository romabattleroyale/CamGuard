# GEMINI_API_KEY: Required for Gemini AI API calls and recipe generation.
# Set a real secret locally; never commit API keys.
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted.
APP_URL=""

# Recipe catalog batch generator
RECIPE_TARGET=50000
RECIPE_BATCH_SIZE=10
RECIPE_MODEL=gemini-2.5-flash
